---
import CookieConsent from '../components/CookieConsent.astro';
// Página standalone (estilo Linktree): SEM Nav e SEM Footer, por decisão do cliente.
// Também sem <WhatsAppButton /> — tem o botão "Grupo de ofertas" (regra do projeto).
import { WHATSAPP, GRUPO_OFERTAS } from '../data/eventos';

const wppFalar = `https://wa.me/${WHATSAPP}`;
const wppNiver = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(
  'Olá! Quero comemorar meu aniversário com o TicketHubh. Como funciona?'
)}`;

// Botões principais da árvore
const links = [
  { texto: 'Ver todos os eventos', href: '/eventos', destaque: true },
  { texto: 'Comemore seu aniversário com a gente', href: wppNiver, externo: true },
  { texto: 'Grupo de ofertas no WhatsApp', href: GRUPO_OFERTAS, externo: true },
  { texto: 'Fale com a gente no WhatsApp', href: wppFalar, externo: true },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Links — TicketHubh</title>
    <meta
      name="description"
      content="Todos os canais do TicketHubh num só lugar: eventos, calendário, blog e o grupo de ofertas no WhatsApp."
    />
  </head>

  <body>
    <main class="tree">
      <section class="tree__card">
        <div class="tree__brand">
          <span class="tree__logo">
            <img src="/favicon.svg" alt="" width="40" height="40" />
          </span>
          <h1 class="tree__nome">TicketHubh</h1>
          <p class="tree__tag">Os melhores rolês da cidade, num só lugar.</p>
        </div>

        <div class="tree__social">
          <a href="#" aria-label="Instagram do TicketHubh">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.7" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" />
              <circle cx="17" cy="7" r="1.2" fill="currentColor" />
            </svg>
          </a>
          <a href="#" aria-label="TikTok do TicketHubh">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
              <path d="M13.5 3v11.2a3.2 3.2 0 1 1-2.4-3.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M13.5 4.5c.7 2 2.3 3.3 4.5 3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="#" aria-label="Google do TicketHubh">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
              <path d="M19.6 12a7.6 7.6 0 1 1-2.2-5.35" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              <path d="M20 12h-6.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </svg>
          </a>
        </div>

        <nav class="tree__links" aria-label="Links do TicketHubh">
          {
            links.map((l) => (
              <a
                class={`lk${l.destaque ? ' lk--destaque' : ''}`}
                href={l.href}
                {...(l.externo ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <span>{l.texto}</span>
                <svg class="lk__seta" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))
          }
        </nav>
      </section>
    </main>

    <CookieConsent />

    <style is:global>
      ::selection {
        background: #2b5cff;
        color: #fff;
      }
    </style>

    <style>
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: #101114;
        background: #fff;
      }
      *:focus-visible {
        outline: 2px solid #2b5cff;
        outline-offset: 3px;
        border-radius: 10px;
      }

      /* Fundo escuro com a textura de pontos da marca */
      .tree {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100vh;
        min-height: 100dvh;
        padding: clamp(2rem, 6vw, 4.5rem) 1.25rem 4rem;
        background-color: #12141a;
        background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1.4px);
        background-size: 16px 16px;
      }

      .tree__card {
        width: 100%;
        max-width: 520px;
      }

      /* Marca */
      .tree__brand {
        text-align: center;
        color: #fff;
        margin-bottom: 1.25rem;
      }
      .tree__logo {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 76px;
        height: 76px;
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 12px 30px -14px rgba(0, 0, 0, 0.6);
      }
      .tree__nome {
        margin: 1rem 0 0;
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -0.03em;
      }
      .tree__tag {
        margin: 0.4rem 0 0;
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.82);
      }

      /* Botões */
      .tree__links {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }
      .lk {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 1.05rem 1.25rem;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.96);
        color: #101114;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.02rem;
        text-transform: capitalize;
        border: 1px solid transparent;
        transition: transform 0.16s ease, box-shadow 0.18s ease, background 0.16s ease;
      }
      .lk:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 30px -18px rgba(0, 0, 0, 0.7);
        background: #fff;
      }
      .lk__seta {
        flex: none;
        color: #9aa0a6;
        transition: transform 0.18s ease, color 0.18s ease;
      }
      .lk:hover .lk__seta {
        transform: translateX(3px);
        color: #2b5cff;
      }
      /* Botão em destaque (Eventos) */
      .lk--destaque {
        background: #2b5cff;
        color: #fff;
        box-shadow: 0 14px 28px -16px rgba(0, 0, 0, 0.55);
      }
      .lk--destaque:hover {
        background: #1f4de0;
      }
      .lk--destaque .lk__seta {
        color: rgba(255, 255, 255, 0.85);
      }
      .lk--destaque:hover .lk__seta {
        color: #fff;
      }

      /* Social */
      .tree__social {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        margin: 0 0 2rem;
      }
      .tree__social a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.8rem;
        height: 2.8rem;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: rgba(255, 255, 255, 0.85);
        transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
      }
      .tree__social a:hover {
        color: #fff;
        border-color: #fff;
        transform: translateY(-2px);
      }

      @media (prefers-reduced-motion: reduce) {
        .lk,
        .lk__seta,
        .tree__social a {
          transition: none;
        }
      }
    </style>
  </body>
</html>
