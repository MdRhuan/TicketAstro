---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsent from '../components/CookieConsent.astro';

// Página institucional "Como funciona".
// Modelo do negócio (confirmado): o TicketHubh apenas DIVULGA eventos e
// redireciona para o canal de venda de terceiros. Não vende, não recebe
// pagamento, não entrega ingresso. O texto reforça isso de forma clara.

const passos = [
  {
    n: '01',
    titulo: 'Descubra o rolê',
    texto:
      'Navegue pelas festas em Belo Horizonte e pelos shows em outras cidades. Filtre por data, cidade e estilo até achar o que combina com você.',
  },
  {
    n: '02',
    titulo: 'Confira os detalhes',
    texto:
      'Cada evento traz line-up, local, horário, classificação etária e a faixa de preço. Assim você decide antes de sair do site.',
  },
  {
    n: '03',
    titulo: 'Vá para a compra oficial',
    texto:
      'Ao clicar em comprar, você é levado ao canal oficial do produtor ou à plataforma de ingressos parceira. É lá que o pagamento e a emissão do ingresso acontecem.',
  },
  {
    n: '04',
    titulo: 'Fique por dentro',
    texto:
      'Entre no nosso grupo de ofertas e fale com a gente no WhatsApp para receber avisos de novos eventos e tirar dúvidas.',
  },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Como funciona o TicketHubh</title>
    <meta
      name="description"
      content="Como o TicketHubh funciona: descubra festas em BH e shows, confira os detalhes e vá direto para o canal oficial de compra do evento."
    />
  </head>

  <body style="margin:0">
    <Nav />

    <main class="pg">
      <header class="pg__head">
        <p class="pg__eyebrow">Como funciona</p>
        <h1 class="pg__title">Encontrar o rolê certo é rápido</h1>
        <p class="pg__lead">
          O TicketHubh reúne festas de Belo Horizonte e shows de várias cidades
          num só lugar. Você descobre o evento aqui e compra o ingresso no canal
          oficial de quem organiza. Em quatro passos:
        </p>
      </header>

      <ol class="passos">
        {
          passos.map((p) => (
            <li class="passo">
              <span class="passo__n">{p.n}</span>
              <div class="passo__txt">
                <h2>{p.titulo}</h2>
                <p>{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <aside class="aviso">
        <h2 class="aviso__h">Uma coisa importante</h2>
        <p>
          O <strong>TicketHubh não vende ingressos</strong> e não processa
          pagamentos. Nós divulgamos os eventos e mandamos você para o canal
          oficial de venda. A compra, a emissão do ingresso e qualquer questão
          de pagamento, troca, reembolso ou cancelamento são tratadas
          diretamente com o produtor do evento ou com a plataforma de venda.
        </p>
        <p class="aviso__link">
          Veja os detalhes nos <a href="/termos">Termos de Uso</a> e nas
          perguntas frequentes do <a href="/faq">FAQ</a>.
        </p>
      </aside>

      <div class="cta">
        <a class="cta__btn cta__btn--pri" href="/eventos">Ver todos os eventos</a>
        <a class="cta__btn cta__btn--sec" href="/calendario">Abrir o calendário</a>
      </div>
    </main>

    <Footer />
    <WhatsAppButton />
    <CookieConsent />

    <style>
      .pg {
        max-width: 820px;
        margin-inline: auto;
        padding: clamp(2.5rem, 5vw, 4rem) 1.5rem 3rem;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: #3a3f46;
        line-height: 1.65;
      }
      .pg__eyebrow {
        margin: 0 0 0.5rem;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #2b5cff;
      }
      .pg__title {
        margin: 0;
        font-size: clamp(2rem, 5vw, 2.6rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #101114;
      }
      .pg__lead {
        margin: 1.25rem 0 0;
        font-size: 1.05rem;
        max-width: 60ch;
      }

      .passos {
        list-style: none;
        margin: 2.75rem 0 0;
        padding: 0;
        display: grid;
        gap: 1rem;
      }
      .passo {
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
        padding: 1.4rem 1.5rem;
        background: #fff;
        border: 2px solid #101114;
        border-radius: 16px;
      }
      .passo__n {
        flex: none;
        font-size: 1rem;
        font-weight: 800;
        color: #2b5cff;
        background: #eef2ff;
        border-radius: 10px;
        padding: 0.4rem 0.65rem;
        letter-spacing: -0.02em;
      }
      .passo__txt h2 {
        margin: 0 0 0.3rem;
        font-size: 1.15rem;
        font-weight: 700;
        color: #101114;
      }
      .passo__txt p {
        margin: 0;
      }

      .aviso {
        margin: 2rem 0 0;
        padding: 1.5rem;
        background: #f6f6f7;
        border: 2px solid #101114;
        border-radius: 14px;
      }
      .aviso__h {
        margin: 0 0 0.6rem;
        font-size: 1rem;
        font-weight: 700;
        color: #101114;
      }
      .aviso p {
        margin: 0 0 0.75rem;
      }
      .aviso p:last-child {
        margin-bottom: 0;
      }
      .aviso strong {
        color: #101114;
      }
      .aviso a {
        color: #2b5cff;
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2.5rem;
      }
      .cta__btn {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        padding: 0.7rem 1.5rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        transition: background 0.18s ease, border-color 0.18s ease,
          color 0.18s ease, transform 0.16s ease;
      }
      .cta__btn:active {
        transform: translateY(1px);
      }
      .cta__btn--pri {
        background: #2b5cff;
        color: #fff;
        border: 1px solid #2b5cff;
      }
      .cta__btn--pri:hover {
        background: #1f4de0;
        border-color: #1f4de0;
      }
      .cta__btn--sec {
        background: #fff;
        color: #101114;
        border: 1px solid #d3d3d9;
      }
      .cta__btn--sec:hover {
        border-color: #101114;
      }

      *:focus-visible {
        outline: 2px solid #2b5cff;
        outline-offset: 3px;
        border-radius: 8px;
      }

      @media (prefers-reduced-motion: reduce) {
        .cta__btn {
          transition: none;
        }
      }
    </style>
  </body>
</html>
