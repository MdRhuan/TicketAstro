---
import BaseHead from '../components/BaseHead.astro';
import SiteSchema from '../components/schema/SiteSchema.astro';
import Nav from '../components/Nav.astro';
import EventosCarousel from '../components/EventosCarousel.astro';
import EventosGrid from '../components/EventosGrid.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsent from '../components/CookieConsent.astro';
---

<html lang="pt-BR">
	<head>
		<BaseHead
			title="TicketHubh | Festas em BH e shows em um só lugar"
			description="Descubra as festas e os shows de Belo Horizonte: line-up, local, horário e preço num só lugar, com link direto para o canal oficial de compra."
		/>
		<SiteSchema />
	</head>
	<body style="margin:0">
		<Nav />
		<EventosCarousel />
		<EventosGrid />
		<Footer />
		<WhatsAppButton />
		<CookieConsent />
	</body>
</html>
