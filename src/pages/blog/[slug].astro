---
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumbs from '../../components/schema/Breadcrumbs.astro';
import { imagemLocal } from '../../lib/imagem';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { posts, type Post } from '../../data/posts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}
const { post: p } = Astro.props;

// Sugestões: outros posts (até 3), mais recentes primeiro
const outros = posts
  .filter((x) => x.slug !== p.slug)
  .sort((a, b) => b.dataISO.localeCompare(a.dataISO))
  .slice(0, 3);

const titulo = `${p.titulo} | Blog TicketHubh`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: p.titulo,
  datePublished: p.dataISO,
  author: { '@type': 'Organization', name: p.autor },
  image: [new URL(imagemLocal(p.imagem), Astro.site).href],
  description: p.resumo,
};
---

<html lang="pt-BR">
  <head>
    <BaseHead title={titulo} description={p.resumo} image={p.imagem} type="article" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Breadcrumbs
      items={[
        { name: 'Blog', path: '/blog' },
        { name: p.titulo, path: `/blog/${p.slug}` },
      ]}
    />
  </head>

  <body>
    <Nav />

    <main>
      <article class="art">
        <header class="art-hero" style={`--cor:${p.cor}`}>
          <div class="art-hero__media">
            <div class="art-hero__poster" aria-hidden="true"></div>
            <img
              class="art-hero__img"
              src={p.imagem}
              alt={`${p.titulo} — ${p.categoria}`}
              width="1600"
              height="900"
              onerror="this.closest('.art-hero__media').classList.add('sem-foto')"
            />
            <div class="art-hero__scrim"></div>
          </div>
          <div class="art-hero__inner">
            <nav class="mig" aria-label="Você está em">
              <a href="/blog">Blog</a>
              <span aria-hidden="true">›</span>
              <span>{p.categoria}</span>
            </nav>
            <h1 class="art-hero__titulo">{p.titulo}</h1>
            <p class="art-hero__meta">
              {p.autor}<span class="sep" aria-hidden="true">·</span>{p.dataLabel}<span class="sep" aria-hidden="true">·</span>{p.tempoLeitura} min de leitura
            </p>
          </div>
        </header>

        <div class="art-body">
          <p class="art-lead">{p.resumo}</p>
          {p.corpo.map((par) => <p class="art-p">{par}</p>)}

          <a class="voltar" href="/blog">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true">
              <path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Voltar ao blog
          </a>
        </div>
      </article>

      {
        outros.length > 0 && (
          <section class="mais">
            <h2 class="sec-titulo">Continue lendo</h2>
            <ul class="mais-grade">
              {outros.map((o) => (
                <li>
                  <a class="mini" href={`/blog/${o.slug}`} style={`--cor:${o.cor}`}>
                    <div class="mini__media">
                      <div class="mini__poster" aria-hidden="true" />
                      <img
                        class="mini__img"
                        src={o.imagem}
                        alt={`${o.titulo} — ${o.categoria}`}
                        loading="lazy"
                        decoding="async"
                        width="480"
                        height="300"
                        onerror="this.closest('.mini__media').classList.add('sem-foto')"
                      />
                    </div>
                    <span class="mini__cat">{o.categoria}</span>
                    <h3 class="mini__titulo">{o.titulo}</h3>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>

    <Footer />
    <WhatsAppButton />
    <CookieConsent />

    <style is:global>
      ::selection {
        background: var(--marca);
        color: #fff;
      }
    </style>

    <style>
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--texto);
        background: #fff;
      }
      *:focus-visible {
        outline: 2px solid var(--marca);
        outline-offset: 3px;
        border-radius: 6px;
      }

      /* Hero do artigo */
      .art-hero {
        position: relative;
        display: flex;
        align-items: flex-end;
        min-height: clamp(300px, 46vh, 500px);
        color: #fff;
        overflow: hidden;
        background: var(--fundo-escuro);
      }
      .art-hero__media {
        position: absolute;
        inset: 0;
        z-index: 0;
      }
      .art-hero__poster {
        position: absolute;
        inset: 0;
        background: linear-gradient(150deg,
          color-mix(in srgb, var(--cor, var(--marca)) 88%, #fff) 0%,
          color-mix(in srgb, var(--cor, var(--marca)) 74%, #000) 100%);
      }
      .art-hero__poster::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1.4px);
        background-size: 15px 15px;
        mask-image: linear-gradient(160deg, #000, transparent 78%);
      }
      .art-hero__img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
      }
      .art-hero__media.sem-foto .art-hero__img {
        display: none;
      }
      .art-hero__scrim {
        position: absolute;
        inset: 0;
        z-index: 2;
        background: linear-gradient(180deg, rgba(8, 8, 12, 0.15) 0%, rgba(8, 8, 12, 0.35) 45%, rgba(8, 8, 12, 0.85) 100%);
      }
      .art-hero__inner {
        position: relative;
        z-index: 3;
        width: 100%;
        max-width: 760px;
        margin-inline: auto;
        padding: 2.5rem 1.5rem 2.75rem;
      }
      .mig {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        margin-bottom: 1rem;
        color: rgba(255, 255, 255, 0.8);
      }
      .mig a {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
      }
      .mig a:hover {
        color: #fff;
      }
      .art-hero__titulo {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3.2rem);
        line-height: 1.05;
        font-weight: 800;
        letter-spacing: -0.035em;
        text-shadow: 0 2px 30px rgba(0, 0, 0, 0.45);
        max-width: 20ch;
      }
      .art-hero__meta {
        margin: 0.9rem 0 0;
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.9);
      }
      .sep {
        margin: 0 0.5rem;
      }

      /* Corpo (medida de leitura confortável) */
      .art-body {
        max-width: 680px;
        margin-inline: auto;
        padding: 2.75rem 1.5rem 1rem;
      }
      .art-lead {
        margin: 0 0 1.75rem;
        font-size: 1.3rem;
        line-height: 1.5;
        font-weight: 500;
        color: var(--texto);
      }
      .art-p {
        margin: 0 0 1.35rem;
        font-size: 1.12rem;
        line-height: 1.75;
        color: #2a2f36;
      }
      .voltar {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin: 1.5rem 0 0;
        font-weight: 700;
        color: var(--marca);
        text-decoration: none;
      }
      .voltar svg {
        transition: transform 0.2s ease;
      }
      .voltar:hover svg {
        transform: translateX(-3px);
      }

      /* Continue lendo */
      .mais {
        max-width: 1140px;
        margin-inline: auto;
        padding: 2.5rem 1.5rem 4.5rem;
      }
      .sec-titulo {
        margin: 0 0 1.25rem;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--texto-muted);
      }
      .mais-grade {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }
      .mini {
        display: block;
        text-decoration: none;
        color: inherit;
      }
      .mini__media {
        position: relative;
        aspect-ratio: 16 / 10;
        border-radius: 14px;
        overflow: hidden;
        background: var(--cor, var(--marca));
        margin-bottom: 0.85rem;
      }
      .mini__poster {
        position: absolute;
        inset: 0;
        background: linear-gradient(150deg,
          color-mix(in srgb, var(--cor, var(--marca)) 88%, #fff) 0%,
          color-mix(in srgb, var(--cor, var(--marca)) 74%, #000) 100%);
      }
      .mini__poster::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1.4px);
        background-size: 13px 13px;
        mask-image: linear-gradient(160deg, #000, transparent 78%);
      }
      .mini__img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
      }
      .mini__media.sem-foto .mini__img {
        display: none;
      }
      .mini__cat {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--texto-muted);
      }
      .mini__titulo {
        margin: 0.3rem 0 0;
        font-size: 1.12rem;
        line-height: 1.2;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--texto);
        transition: color 0.16s ease;
      }
      .mini:hover .mini__titulo {
        color: var(--marca);
      }

      @media (max-width: 720px) {
        .mais-grade {
          grid-template-columns: 1fr;
          gap: 1.75rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .voltar svg,
        .mini__titulo {
          transition: none;
        }
      }
    </style>
  </body>
</html>
