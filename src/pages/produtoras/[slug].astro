---
import BaseHead from '../../components/BaseHead.astro';
import Breadcrumbs from '../../components/schema/Breadcrumbs.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { produtorasPublicadas, eventosDaProdutora, type Produtora } from '../../data/produtoras';
import { iniciais } from '../../data/eventos';

// Só gera página para produtora publicada (trava anti-conteúdo-fino em produtoras.ts).
// Com a lista de publicadas vazia, nenhuma página de produtora é gerada ainda.
export function getStaticPaths() {
  return produtorasPublicadas.map((produtora) => ({
    params: { slug: produtora.slug },
    props: { produtora },
  }));
}

interface Props {
  produtora: Produtora;
}
const { produtora: p } = Astro.props;

const site = Astro.site!;
// Camada B: eventos futuros desta produtora (entram e saem sozinhos).
const eventos = eventosDaProdutora(p.nome);

const cidadeCurta = p.cidade === 'Belo Horizonte' ? 'BH' : p.cidade;
const titulo = `${p.nome}: próximas festas em ${cidadeCurta} | TicketHubh`;

// Lista "a, b e c" em linguagem natural.
function listar(xs: string[]): string {
  if (xs.length <= 1) return xs[0] ?? '';
  return `${xs.slice(0, -1).join(', ')} e ${xs[xs.length - 1]}`;
}
// Frase de bairros (sinal local) — só quando houver bairro real cadastrado.
const bairrosFrase =
  p.bairros.length > 0
    ? `A ${p.nome} realiza festas em ${p.cidade}, com presença em ${listar(p.bairros)}.`
    : '';

// Canais oficiais verificáveis (sameAs do schema e links do perfil).
const canais = [
  p.instagram ? { rotulo: 'Instagram', url: p.instagram } : null,
  p.sympla ? { rotulo: 'Sympla', url: p.sympla } : null,
  p.site ? { rotulo: 'Site oficial', url: p.site } : null,
].filter((c): c is { rotulo: string; url: string } => c !== null);

// areaServed: cidade + bairros reais (sinal geográfico, nunca inventado).
const areaServed = [
  {
    '@type': 'City',
    name: p.cidade,
    address: { '@type': 'PostalAddress', addressRegion: 'MG', addressCountry: 'BR' },
  },
  ...p.bairros.map((b) => ({ '@type': 'Place', name: b })),
];

// subjectOf → ItemList dos eventos futuros (organizer = a própria produtora).
const itemListElement = eventos.map((e, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  item: {
    '@type': 'Event',
    name: e.nome,
    startDate: `${e.dataISO}T${e.horaAbertura}:00-03:00`,
    organizer: { '@type': 'Organization', name: p.nome },
    location: {
      '@type': 'Place',
      name: e.local,
      address: {
        '@type': 'PostalAddress',
        streetAddress: e.endereco.replace(/\s*\|\s*/g, ', '),
        addressLocality: e.cidade,
        addressRegion: 'MG',
        addressCountry: 'BR',
      },
    },
    ...(e.linkCompra && e.linkCompra !== '#'
      ? { offers: { '@type': 'Offer', url: e.linkCompra, availability: 'https://schema.org/InStock' } }
      : {}),
  },
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: p.nome,
  url: new URL(`/produtoras/${p.slug}/`, site).href,
  description: p.perfil.join(' '),
  areaServed,
  ...(canais.length ? { sameAs: canais.map((c) => c.url) } : {}),
  ...(itemListElement.length
    ? {
        subjectOf: {
          '@type': 'ItemList',
          name: `Próximas festas da ${p.nome} em ${p.cidade}`,
          itemListElement,
        },
      }
    : {}),
};
---

<html lang="pt-BR">
  <head>
    <BaseHead title={titulo} description={p.resumo} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Breadcrumbs
      items={[
        { name: 'Produtoras', path: '/produtoras' },
        { name: p.nome, path: `/produtoras/${p.slug}` },
      ]}
    />
  </head>

  <body>
    <Nav />

    <main class="prod">
      <header class="prod__head">
        <nav class="prod__mig" aria-label="Você está em">
          <a href="/produtoras">Produtoras</a>
          <span aria-hidden="true">›</span>
          <span>{p.nome}</span>
        </nav>
        <div class="prod__id">
          <div class={`prod__avatar${p.foto ? '' : ' sem-foto'}`} style={`--cor:${p.cor ?? '#14151b'}`}>
            {p.foto && (
              <img
                class="prod__foto"
                src={p.foto}
                alt={`Foto de perfil da ${p.nome}`}
                loading="eager"
                decoding="async"
                onerror="this.closest('.prod__avatar').classList.add('sem-foto')"
              />
            )}
            <span class="prod__ini" aria-hidden="true">{iniciais(p.nome)}</span>
          </div>
          <div class="prod__id-txt">
            <h1 class="prod__titulo">{p.nome}</h1>
            {p.estilo && <p class="prod__estilo">{p.estilo} · {p.cidade}</p>}
          </div>
        </div>
      </header>

      <section class="prod__perfil" aria-label="Sobre a produtora">
        {p.perfil.map((par) => <p class="prod__p">{par}</p>)}
        {bairrosFrase && <p class="prod__p">{bairrosFrase}</p>}

        {
          canais.length > 0 && (
            <p class="prod__canais">
              <span>Canais oficiais:</span>
              {canais.map((c) => (
                <a href={c.url} target="_blank" rel="noopener nofollow">
                  {c.rotulo}
                </a>
              ))}
            </p>
          )
        }
      </section>

      <section class="prod__eventos" aria-labelledby="prod-eventos-titulo">
        <h2 class="prod__h2" id="prod-eventos-titulo">Próximas festas da {p.nome}</h2>
        {
          eventos.length > 0 ? (
            <ul class="prod__lista">
              {eventos.map((e) => (
                <li>
                  <a class="prod__ev" href={`/eventos/${e.slug}/`}>
                    <span class="prod__ev-data">{e.dataLabel}</span>
                    <span class="prod__ev-info">
                      <span class="prod__ev-nome">{e.nome}</span>
                      <span class="prod__ev-local">
                        {e.local} · {e.cidade}
                      </span>
                    </span>
                    <svg class="prod__ev-seta" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
                      <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="prod__vazio">
              Sem festas marcadas no momento. Assim que houver nova data, ela aparece aqui.
            </p>
          )
        }
      </section>
    </main>

    <Footer />
    <WhatsAppButton />
    <CookieConsent />

    <style>
      body {
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      .prod {
        max-width: 820px;
        margin-inline: auto;
        padding: 2rem 1.5rem 4.5rem;
      }
      .prod__mig {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        font-size: 0.85rem;
        color: var(--texto-3);
        margin-bottom: 0.9rem;
      }
      .prod__mig a {
        color: var(--marca);
        text-decoration: none;
      }
      .prod__titulo {
        margin: 0;
        font-size: clamp(1.8rem, 5vw, 2.4rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--texto);
      }
      .prod__estilo {
        margin: 0.4rem 0 0;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--marca);
      }
      /* Cabeçalho de identidade: avatar redondo (foto de perfil) ao lado do nome. */
      .prod__id {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 0.4rem;
      }
      .prod__id-txt {
        min-width: 0;
      }
      .prod__avatar {
        flex: none;
        width: 88px;
        height: 88px;
        border-radius: 50%;
        overflow: hidden;
        background: var(--cor, #14151b);
        display: grid;
        place-items: center;
      }
      .prod__foto {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .prod__avatar.sem-foto .prod__foto {
        display: none;
      }
      .prod__ini {
        display: none;
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        color: #fff;
      }
      .prod__avatar.sem-foto .prod__ini {
        display: block;
      }
      .prod__perfil {
        margin-top: 1.75rem;
      }
      .prod__p {
        margin: 0 0 1rem;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--texto-2);
      }
      .prod__canais {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: baseline;
        margin: 1.25rem 0 0;
        font-size: 0.95rem;
        color: var(--texto-3);
      }
      .prod__canais a {
        color: var(--marca);
        font-weight: 600;
        text-decoration: none;
      }
      .prod__canais a:hover {
        text-decoration: underline;
      }
      .prod__eventos {
        margin-top: 3rem;
      }
      .prod__h2 {
        margin: 0 0 1.25rem;
        font-size: 1.3rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--texto);
      }
      .prod__lista {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .prod__ev {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.1rem;
        text-decoration: none;
        background: #fff;
        border: 1px solid var(--borda);
        border-radius: 12px;
        transition: border-color 0.2s ease, transform 0.2s ease;
      }
      .prod__ev:hover {
        transform: translateY(-2px);
        border-color: var(--texto);
      }
      .prod__ev-data {
        flex: none;
        font-size: 0.82rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--marca);
      }
      .prod__ev-info {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        flex: 1;
      }
      .prod__ev-nome {
        font-weight: 700;
        color: var(--texto);
      }
      .prod__ev-local {
        font-size: 0.85rem;
        color: var(--texto-3);
      }
      .prod__ev-seta {
        flex: none;
        color: var(--texto-3);
      }
      .prod__vazio {
        font-size: 1rem;
        color: var(--texto-3);
      }
    </style>
  </body>
</html>
