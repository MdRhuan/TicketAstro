---
import { Image } from 'astro:assets';
import logo from '../assets/LogoTH.webp';

const ano = new Date().getFullYear();

const navegar = [
  { href: '/', texto: 'Início' },
  { href: '/eventos', texto: 'Festas' },
  { href: '/grupos', texto: 'Grupos' },
  { href: '/calendario', texto: 'Calendário' },
  { href: '/blog', texto: 'Blog' },
  { href: '/sobre', texto: 'Sobre' },
];
const legal = [
  { href: '/faq', texto: 'FAQ' },
  { href: '/como-funciona', texto: 'Como funciona' },
  { href: '/termos', texto: 'Termos de Uso' },
  { href: '/privacidade', texto: 'Política de Privacidade' },
  { href: '/links', texto: 'Árvore de links' },
];

// WhatsApp real fornecido pelo cliente
const whatsappNumero = '+55 (31) 98315-8818';
const whatsappLink = 'https://wa.me/5531983158818';
---

<footer class="ft">
  <div class="ft__wrap">
    <div class="ft__top">
      <div class="ft__brand">
        <a href="/" class="ft__logo" aria-label="TicketHubh — início">
          <Image src={logo} alt="" class="ft__logo-img" loading="lazy" />
          <span class="ft__logo-txt">TicketHubh</span>
        </a>
        <p class="ft__tag">Festas e Shows de BH Em Um Só Lugar, Com Ingresso Mais Barato.</p>
      </div>

      <nav class="ft__cols" aria-label="Rodapé">
        <div class="ft__col">
          <h3>Navegar</h3>
          <ul>
            {navegar.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
          </ul>
        </div>
        <div class="ft__col">
          <h3>Legal</h3>
          <ul>
            {legal.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
          </ul>
        </div>
        <div class="ft__col ft__col--aten">
          <h3>Atendimento</h3>
          <a class="ft__aten-txt" href="/contato">Contato</a>
          <a class="ft__wpp" href={whatsappLink} target="_blank" rel="noopener">
            WhatsApp : {whatsappNumero}
          </a>

          <div class="ft__social">
            <a href="https://www.instagram.com/tickethubh/" target="_blank" rel="noopener" aria-label="Instagram do TicketHubh">
              <img src="/social/instagram.svg" width="20" height="20" alt="" aria-hidden="true" loading="lazy" />
            </a>
            <a href={whatsappLink} target="_blank" rel="noopener" aria-label="WhatsApp do TicketHubh">
              <img src="/social/whatsapp.svg" width="20" height="20" alt="" aria-hidden="true" loading="lazy" />
            </a>
            <a href="https://g.page/r/CcnVTNNZ-cF7EAE/review" target="_blank" rel="noopener" aria-label="Google do TicketHubh">
              <img src="/social/google.svg" width="20" height="20" alt="" aria-hidden="true" loading="lazy" />
            </a>
          </div>
        </div>
      </nav>
    </div>

    <div class="ft__bottom">
      <span>© {ano} TicketHubh. Todos os direitos reservados.</span>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: var(--superficie);
    border-top: 1px solid var(--borda);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .ft__wrap {
    max-width: 1140px;
    margin-inline: auto;
    padding: 3.5rem 1.5rem 2rem;
  }

  .ft__top {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 3rem;
    justify-content: space-between;
  }

  /* Marca */
  .ft__brand {
    flex: 1 1 240px;
    max-width: 22rem;
  }
  .ft__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--texto);
    text-decoration: none;
  }
  .ft__logo-img {
    display: block;
    height: 34px;
    width: auto; /* preserva a proporção do LogoTH (evita distorção e CLS) */
  }
  .ft__tag {
    margin: 0.75rem 0 1.1rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--texto-3);
  }
  .ft__social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .ft__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    border: 1px solid #e0e0e4;
    color: var(--texto-3);
    background: #fff;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .ft__social a:hover {
    color: var(--marca);
    border-color: var(--marca);
    transform: translateY(-2px);
  }

  /* Colunas de links */
  .ft__cols {
    flex: 2 1 560px;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 2.5rem;
  }
  .ft__col {
    flex: 1 1 130px;
    min-width: 130px;
  }
  .ft__col--aten {
    flex: 1 1 180px;
  }
  .ft__col h3 {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto);
  }
  .ft__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .ft__col a {
    font-size: 0.92rem;
    color: var(--texto-2);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .ft__col a:hover {
    color: var(--marca);
  }

  /* Atendimento / WhatsApp */
  .ft__aten-txt {
    display: inline-block;
    margin: 0 0 0.6rem;
    font-size: 0.92rem;
    color: var(--texto-2);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .ft__aten-txt:hover {
    color: var(--marca);
  }
  .ft__wpp {
    display: block;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--texto);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .ft__wpp:hover {
    color: var(--marca);
  }

  /* Barra inferior */
  .ft__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--borda);
    font-size: 0.85rem;
    color: #9a9aa3;
  }

  *:focus-visible {
    outline: 2px solid var(--marca);
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .ft__brand {
      flex-basis: 100%;
      max-width: none;
    }
    .ft__cols {
      flex-basis: 100%;
    }
  }
</style>
