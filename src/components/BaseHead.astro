---
// ─────────────────────────────────────────────────────────────────────────────
// <head> compartilhado de todas as páginas.
// Centraliza: charset, favicons, título, description, canonical, Open Graph e
// Twitter Cards. Assim os metadados ficam consistentes e mudam num lugar só.
//
// Uso na página:
//   import BaseHead from '../components/BaseHead.astro';
//   <head><BaseHead title="..." description="..." /></head>
//
// IMAGEM SOCIAL (og:image): usa /og-default.jpg (a "Capa") por padrão (1200×675).
//   → Páginas de evento e post passam a foto própria via `image`. Se essa foto
//     ainda não existir em public/, cai automaticamente na Capa — assim o
//     preview nunca fica quebrado e troca sozinho quando a foto real for criada.
// ─────────────────────────────────────────────────────────────────────────────

import { imagemOG } from '../lib/imagem';
import '../styles/tokens.css'; // tokens de cor globais (todas as páginas usam BaseHead)

export interface Props {
  title: string;
  description: string;
  image?: string; // caminho a partir da raiz, ex.: '/eventos/festa-neon.jpg'
  imageAlt?: string; // texto alternativo da imagem social (padrão: o título)
  type?: 'website' | 'article';
  noindex?: boolean; // true em páginas que não devem ser indexadas (ex.: 404)
}

const {
  title,
  description,
  image = '/og-default.jpg',
  imageAlt,
  type = 'website',
  noindex = false,
} = Astro.props;

// URLs absolutas exigem Astro.site (definido em astro.config.mjs).
// A canonical evita conteúdo duplicado; a og:image precisa ser absoluta para
// os scrapers de redes sociais lerem a imagem.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// og: resolve a imagem (com fallback) E mede as dimensões reais no build,
// para o preview social não "pular" nem cortar torto.
const og = await imagemOG(image);
const imageAbs = new URL(og.url, Astro.site).href;
const ogAlt = imageAlt ?? title;
const siteName = 'TicketHubh';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<link rel="icon" href="/favicon.ico?v=2" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph (WhatsApp, Facebook, LinkedIn) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageAbs} />
<meta property="og:image:alt" content={ogAlt} />
{og.width && <meta property="og:image:width" content={String(og.width)} />}
{og.height && <meta property="og:image:height" content={String(og.height)} />}
<meta property="og:locale" content="pt_BR" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageAbs} />
<meta name="twitter:image:alt" content={ogAlt} />
