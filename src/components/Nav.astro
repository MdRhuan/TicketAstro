---
import { Image } from 'astro:assets';
import logo from '../assets/LogoTH.webp';

const rota = Astro.url.pathname;
const links = [
  { href: '/', texto: 'Início' },
  { href: '/eventos', texto: 'Festas' },
  { href: '/grupos', texto: 'Grupos' },
  { href: '/calendario', texto: 'Calendário' },
  { href: '/blog', texto: 'Blog' },
];
const ativo = (href: string) =>
  href === '/' ? rota === '/' : rota.startsWith(href);
---

<nav class="nav" aria-label="Navegação principal" data-nav>
  <a href="/" class="nav__marca">
    <Image src={logo} alt="" class="nav__logo" loading="eager" />
    <span>TicketHubh</span>
  </a>

  <button
    type="button"
    class="nav__toggle"
    aria-expanded="false"
    aria-controls="nav-menu"
    aria-label="Abrir menu"
    data-nav-toggle
  >
    <span class="nav__burger" aria-hidden="true"></span>
  </button>

  <ul class="nav__links" id="nav-menu">
    {
      links.map((link) => (
        <li>
          <a href={link.href} aria-current={ativo(link.href) ? 'page' : undefined}>
            {link.texto}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: 1.35rem 1.5rem;
    border-bottom: 1px solid #e5e5e5;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    position: relative;
    background: #fff;
  }

  .nav__marca {
    /* Coluna da esquerda; deslocado um pouco para dentro (não colado à borda) */
    grid-column: 1;
    justify-self: start;
    margin-left: 2.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.4rem;
    font-weight: 700;
    color: #111;
    text-decoration: none;
  }
  .nav__logo {
    display: block;
    height: 34px;
    width: auto; /* preserva a proporção do LogoTH (evita distorção e CLS) */
  }

  .nav__links {
    /* Coluna central; links centrados */
    grid-column: 2;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links a {
    color: #444;
    text-decoration: none;
    font-size: 1.1rem;
  }
  .nav__links a:hover {
    color: #111;
  }
  .nav__links a[aria-current='page'] {
    color: #111;
    font-weight: 600;
  }

  /* Botão hambúrguer — escondido no desktop */
  .nav__toggle {
    grid-column: 3;
    justify-self: end;
    margin-right: 1rem;
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
  }
  .nav__toggle:focus-visible {
    outline: 2px solid var(--marca, #2b5cff);
    outline-offset: 2px;
  }

  /* Ícone: 3 barras que viram X quando aberto */
  .nav__burger,
  .nav__burger::before,
  .nav__burger::after {
    content: "";
    display: block;
    width: 22px;
    height: 2px;
    background: #111;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav__burger {
    position: relative;
  }
  .nav__burger::before {
    position: absolute;
    top: -7px;
  }
  .nav__burger::after {
    position: absolute;
    top: 7px;
  }
  .nav__toggle[aria-expanded='true'] .nav__burger {
    background: transparent;
  }
  .nav__toggle[aria-expanded='true'] .nav__burger::before {
    top: 0;
    transform: rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] .nav__burger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* ───────── Mobile ───────── */
  @media (max-width: 768px) {
    .nav {
      display: flex;
      justify-content: space-between;
      padding: 1rem 1rem;
    }
    .nav__marca {
      margin-left: 0;
      font-size: 1.25rem;
    }
    .nav__toggle {
      display: inline-flex;
      margin-right: 0;
    }
    .nav__links {
      grid-column: auto;
      justify-self: auto;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 1000;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      border-bottom: 1px solid #e5e5e5;
      box-shadow: 0 12px 24px -16px rgba(16, 17, 20, 0.35);
      /* Escondido por padrão */
      display: none;
    }
    .nav[data-nav-aberto] .nav__links {
      display: flex;
    }
    .nav__links li {
      border-top: 1px solid #f0f0f0;
    }
    .nav__links a {
      display: block;
      padding: 0.9rem 1.25rem;
      font-size: 1.05rem;
    }
    .nav__links a[aria-current='page'] {
      background: #f6f7f9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__burger,
    .nav__burger::before,
    .nav__burger::after {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]');
  const toggle = document.querySelector('[data-nav-toggle]');

  if (nav && toggle) {
    const fechar = () => {
      nav.removeAttribute('data-nav-aberto');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menu');
    };
    const abrir = () => {
      nav.setAttribute('data-nav-aberto', '');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Fechar menu');
    };

    toggle.addEventListener('click', () => {
      const aberto = toggle.getAttribute('aria-expanded') === 'true';
      aberto ? fechar() : abrir();
    });

    // Fecha ao clicar num link
    nav.querySelectorAll('.nav__links a').forEach((a) =>
      a.addEventListener('click', fechar)
    );

    // Fecha com Esc
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') fechar();
    });

    // Fecha ao voltar para largura de desktop
    window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
      if (e.matches) fechar();
    });
  }
</script>
