---
const rota = Astro.url.pathname;
const links = [
  { href: '/', texto: 'Início' },
  { href: '/eventos', texto: 'Eventos' },
  { href: '/calendario', texto: 'Calendário' },
  { href: '/blog', texto: 'Blog' },
];
const ativo = (href: string) =>
  href === '/' ? rota === '/' : rota.startsWith(href);
---

<nav class="nav" aria-label="Navegação principal">
  <a href="/" class="nav__marca">
    <img src="/favicon.svg" alt="" width="28" height="28" class="nav__logo" />
    <span>TicketHubh</span>
  </a>

  <ul class="nav__links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} aria-current={ativo(link.href) ? 'page' : undefined}>
            {link.texto}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #e5e5e5;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }

  .nav__marca {
    /* Coluna da esquerda; deslocado um pouco para dentro (não colado à borda) */
    justify-self: start;
    margin-left: 2.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: #111;
    text-decoration: none;
  }
  .nav__logo {
    display: block;
  }

  .nav__links {
    /* Coluna central; links centrados */
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links a {
    color: #444;
    text-decoration: none;
    font-size: 1rem;
  }
  .nav__links a:hover {
    color: #111;
  }
  .nav__links a[aria-current='page'] {
    color: #111;
    font-weight: 600;
  }
</style>
