---
// SUBSTITUI pelo link de convite do teu grupo de WhatsApp
// (obtém-se no grupo → Convidar via link → Copiar link).
const grupoLink = 'https://chat.whatsapp.com/XXXXXXXXXXXXXXXXXXXX';
---

<a
  class="wpp-fab"
  href={grupoLink}
  target="_blank"
  rel="noopener"
  aria-label="Entrar no grupo de WhatsApp do TicketHubh"
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.8c2.17 0 4.2.85 5.74 2.38a8.06 8.06 0 0 1 2.38 5.73c0 4.47-3.64 8.11-8.12 8.11a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.11.82.83-3.04-.2-.31a8.03 8.03 0 0 1-1.26-4.35c0-4.47 3.64-8.11 8.11-8.11zm-2.7 4.02c-.14 0-.37.05-.56.26-.19.21-.74.72-.74 1.76s.76 2.04.86 2.18c.11.14 1.49 2.36 3.66 3.22 1.8.71 2.17.57 2.56.53.39-.04 1.26-.51 1.44-1.01.18-.5.18-.93.12-1.02-.05-.09-.19-.14-.4-.25-.21-.11-1.26-.62-1.45-.69-.19-.07-.34-.11-.48.11-.14.21-.55.69-.67.83-.12.14-.25.16-.46.05-.21-.11-.9-.33-1.71-1.06-.63-.56-1.06-1.26-1.18-1.47-.12-.21-.01-.32.09-.43.1-.1.21-.25.32-.38.11-.13.14-.22.21-.37.07-.14.04-.27-.02-.38-.05-.11-.48-1.17-.66-1.6-.17-.41-.35-.36-.48-.36l-.41-.01z" />
  </svg>
</a>

<style>
  .wpp-fab {
    position: fixed;
    right: 1.25rem;
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    z-index: 1000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: #25d366;
    color: #fff;
    border-radius: 50%;
    box-shadow: 0 10px 24px -8px rgba(37, 211, 102, 0.6);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  /* Anel de pulsação — borda que expande à frente (visível em qualquer fundo) */
  .wpp-fab::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #25d366;
    pointer-events: none;
    animation: wpp-pulse 1.8s ease-out infinite;
  }
  @keyframes wpp-pulse {
    0% {
      transform: scale(1);
      opacity: 0.75;
    }
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }

  .wpp-fab svg {
    position: relative;
    z-index: 1;
  }

  .wpp-fab:hover {
    background: #1fb457;
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -8px rgba(37, 211, 102, 0.7);
  }
  .wpp-fab:focus-visible {
    outline: 3px solid #101114;
    outline-offset: 3px;
  }

  @media (max-width: 560px) {
    .wpp-fab {
      right: 1rem;
      bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wpp-fab {
      transition: none;
    }
    .wpp-fab::after {
      animation: none;
    }
  }
</style>
